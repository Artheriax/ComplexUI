{
  "name": "vision_video_detection",
  "title": "Video Detection (YOLO)",
  "category": "Computer Vision",
  "description": "Run YOLO11 detection across a synthetic video and write an annotated MP4.",
  "nodes": [
    { "id": "demo", "template": "make_demo_video", "position": { "x": 0, "y": 40 } },
    {
      "id": "model",
      "template": "yolo_detector",
      "position": { "x": 280, "y": 220 },
      "widget_values": { "architecture": "yolo11n", "weights": "none", "device": "cpu" }
    },
    {
      "id": "detect",
      "template": "yolo_detect_video",
      "position": { "x": 560, "y": 40 },
      "widget_values": {
        "output_path": "vision-video-detection.mp4",
        "score_threshold": 0.25,
        "max_detections": 20,
        "max_frames": 48,
        "frame_step": 1
      }
    }
  ],
  "edges": [
    { "source_node_id": "demo", "source_handle": "video", "target_node_id": "detect", "target_handle": "video" },
    { "source_node_id": "model", "source_handle": "model", "target_node_id": "detect", "target_handle": "model" }
  ]
}
