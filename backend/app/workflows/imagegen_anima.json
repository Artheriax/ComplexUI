{
  "name": "imagegen_anima",
  "title": "Anima - Masked Inpaint",
  "category": "Image Generation",
  "description": "Replace a feathered region of a source image with Anima, its Cosmos conditioner and zeroed negative conditioning.",
  "nodes": [
    {
      "id": "resolution",
      "template": "resolution",
      "position": {
        "x": 0,
        "y": 0
      },
      "widget_values": {
        "size_mode": "Resolution",
        "width": 1024,
        "height": 1024
      }
    },
    {
      "id": "diffusion",
      "template": "load_diffusion_model",
      "position": {
        "x": 0,
        "y": 220
      },
      "widget_values": {
        "unet_name": "models/diffusion/Anima",
        "type": "anima",
        "weight_dtype": "default"
      }
    },
    {
      "id": "clip",
      "template": "load_clip",
      "position": {
        "x": 0,
        "y": 440
      },
      "widget_values": {
        "clip_name": "models/diffusion/Anima",
        "type": "anima",
        "max_sequence_length": 512
      }
    },
    {
      "id": "vae",
      "template": "load_vae",
      "position": {
        "x": 0,
        "y": 660
      },
      "widget_values": {
        "vae_name": "models/diffusion/Anima",
        "weight_dtype": "default"
      }
    },
    {
      "id": "source",
      "template": "make_demo_image",
      "position": {
        "x": 0,
        "y": 880
      },
      "widget_values": {
        "seed": 23
      }
    },
    {
      "id": "mask",
      "template": "make_mask",
      "position": {
        "x": 0,
        "y": 1100
      },
      "widget_values": {
        "shape": "ellipse",
        "margin": 160,
        "feather": 0.04
      }
    },
    {
      "id": "positive",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 0
      },
      "widget_values": {
        "text": "A quiet mountain lake at sunrise, pine trees, soft mist, photorealistic landscape, matching the surrounding light and perspective"
      }
    },
    {
      "id": "negative",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 180
      },
      "widget_values": {
        "text": ""
      }
    },
    {
      "id": "zeroed",
      "template": "conditioning_zero_out",
      "position": {
        "x": 720,
        "y": 180
      },
      "widget_values": {}
    },
    {
      "id": "inpaint",
      "template": "inpaint_conditioner",
      "position": {
        "x": 720,
        "y": 0
      },
      "widget_values": {
        "grow_mask_by": 6
      }
    },
    {
      "id": "latent",
      "template": "empty_latent_image",
      "position": {
        "x": 720,
        "y": 620
      },
      "widget_values": {
        "size_mode": "Resolution",
        "batch_size": 1
      }
    },
    {
      "id": "sampler",
      "template": "ksampler",
      "position": {
        "x": 1080,
        "y": 160
      },
      "widget_values": {
        "seed": 42,
        "steps": 25,
        "denoise": 0.75,
        "cfg": 4.0,
        "sampler_name": "euler",
        "scheduler": "simple"
      }
    },
    {
      "id": "decode",
      "template": "vae_decode",
      "position": {
        "x": 1440,
        "y": 160
      },
      "widget_values": {
        "tiled": false
      }
    },
    {
      "id": "save",
      "template": "save_media",
      "position": {
        "x": 1800,
        "y": 160
      },
      "widget_values": {
        "model_name": "anima_inpaint"
      }
    }
  ],
