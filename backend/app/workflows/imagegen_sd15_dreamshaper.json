{
  "name": "imagegen_sd15_dreamshaper",
  "title": "DreamShaper 8 \u00b7 SD1.5",
  "category": "Image Generation",
  "description": "Text-to-image with a local SD1.5 checkpoint, CFG and DPM++ 2M Karras.",
  "nodes": [
    {
      "id": "resolution",
      "template": "resolution",
      "position": {
        "x": 0,
        "y": 0
      },
      "widget_values": {
        "width": 512,
        "height": 512
      }
    },
    {
      "id": "checkpoint",
      "template": "load_checkpoint",
      "position": {
        "x": 0,
        "y": 220
      },
      "widget_values": {
        "checkpoint_name": "models/diffusion/dreamshaper_8.safetensors"
      }
    },
    {
      "id": "positive",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 0
      },
      "widget_values": {
        "text": "a cozy reading nook by a rain-streaked window, warm lamp light, cinematic, highly detailed"
      }
    },
    {
      "id": "negative",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 220
      },
      "widget_values": {
        "text": "blurry, low quality, watermark, text, deformed"
      }
    },
    {
      "id": "latent",
      "template": "empty_latent_image",
      "position": {
        "x": 360,
        "y": 440
      },
      "widget_values": {
        "batch_size": 1
      }
    },
    {
      "id": "sampler",
      "template": "ksampler",
      "position": {
        "x": 720,
        "y": 160
      },
      "widget_values": {
        "seed": 42,
        "steps": 25,
        "cfg": 7,
        "scheduler": "karras",
        "sampler_name": "dpmpp_2m",
        "control_after_generated": "randomize"
      }
    },
    {
      "id": "decode",
      "template": "vae_decode",
      "position": {
        "x": 1080,
        "y": 160
      },
      "widget_values": {
        "tiled": false
      }
    },
    {
      "id": "save",
      "template": "save_media",
      "position": {
        "x": 1440,
        "y": 160
      },
      "widget_values": {
        "path": "imagegen_sd15_dreamshaper.png"
      }
    }
  ],
  "edges": [
