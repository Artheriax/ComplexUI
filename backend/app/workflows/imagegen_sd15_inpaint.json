{
  "name": "imagegen_sd15_inpaint",
  "title": "DreamShaper 8 - Masked Inpaint",
  "category": "Image Generation",
  "description": "Build inpainting conditioning from a source image and feathered mask, then sample the masked latent at 0.75 denoise.",
  "nodes": [
    {
      "id": "resolution",
      "template": "resolution",
      "position": {
        "x": 0,
        "y": 0
      },
      "widget_values": {
        "size_mode": "Resolution",
        "width": 512,
        "height": 512
      }
    },
    {
      "id": "checkpoint",
      "template": "load_checkpoint",
      "position": {
        "x": 0,
        "y": 220
      },
      "widget_values": {
        "checkpoint_name": "models/diffusion/dreamshaper_8.safetensors"
      }
    },
    {
      "id": "source",
      "template": "make_demo_image",
      "position": {
        "x": 0,
        "y": 440
      },
      "widget_values": {
        "seed": 17
      }
    },
    {
      "id": "mask",
      "template": "make_mask",
      "position": {
        "x": 0,
        "y": 660
      },
      "widget_values": {
        "shape": "ellipse",
        "margin": 96,
        "feather": 0.05
      }
    },
    {
      "id": "positive",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 0
      },
      "widget_values": {
        "text": "A quiet mountain lake at sunrise, pine trees, soft mist, photorealistic landscape"
      }
    },
    {
      "id": "negative",
      "template": "clip_text_encode",
      "position": {
        "x": 360,
        "y": 180
      },
      "widget_values": {
        "text": "blurry, low quality, watermark, text, deformed"
      }
    },
    {
      "id": "inpaint",
      "template": "inpaint_conditioner",
      "position": {
        "x": 720,
        "y": 0
      },
      "widget_values": {
        "grow_mask_by": 6
      }
    },
    {
      "id": "latent",
      "template": "empty_latent_image",
      "position": {
        "x": 720,
        "y": 420
      },
      "widget_values": {
        "size_mode": "Resolution",
        "batch_size": 1
      }
    },
    {
      "id": "sampler",
      "template": "ksampler",
      "position": {
        "x": 1080,
        "y": 160
      },
      "widget_values": {
        "seed": 42,
        "steps": 25,
        "denoise": 0.75,
        "cfg": 7.0,
        "sampler_name": "dpmpp_2m",
        "scheduler": "normal"
      }
    },
    {
      "id": "decode",
      "template": "vae_decode",
      "position": {
        "x": 1440,
        "y": 160
      },
      "widget_values": {
        "tiled": false
      }
    },
    {
      "id": "save",
      "template": "save_media",
      "position": {
        "x": 1800,
        "y": 160
      },
      "widget_values": {
        "model_name": "dreamshaper_8_inpaint"
      }
    }
  ],
