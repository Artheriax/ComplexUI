{
  "name": "complexui-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ComplexUI visual node-graph IDE frontend",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
